<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+).
     The two layers are now genuinely different, which they were not before: both
     pointed at @mipmap/ic_launcher, so the foreground was a copy of the whole
     bitmap at 108dp and the launcher's mask cropped the artwork twice.
       background  the sampled brand navy
       foreground  the handset + arcs ONLY, transparent elsewhere, fitted to the
                   central 66dp safe zone (the outer 18dp on each edge may be
                   clipped by the launcher's mask, so nothing important is there).
     The "Callix PBX" wordmark is deliberately absent from the foreground: the
     launcher already prints the app name under the icon, and a second line of
     type is unreadable at 48dp. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
